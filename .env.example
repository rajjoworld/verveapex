# Environment variables for Verve Apex site
# Copy this file to .env and fill values as needed

# Optional backendless forms endpoint (POST)
REACT_APP_FORMS_ENDPOINT=

# Optional scheduler embed URL (Calendly/Cal.com)
REACT_APP_SCHEDULER_URL=

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
REACT_APP_GA_MEASUREMENT_ID=

# Optional LinkedIn Insight Tag Partner ID
REACT_APP_LINKEDIN_PARTNER_ID=

# Optional Heatmap & User Behavior Analytics Services
# Choose one or more for comprehensive user insights

# Hotjar - Heatmaps, Session Recordings, Feedback Widgets
REACT_APP_HOTJAR_SITE_ID=

# Microsoft Clarity - Free heatmaps and session recordings
REACT_APP_CLARITY_PROJECT_ID=

# FullStory - Advanced session recordings and user analytics
REACT_APP_FULLSTORY_ORG_ID=
